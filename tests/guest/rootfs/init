#!/bin/busybox sh
# bend-vmm guest userspace (busybox). With `bendtest` on the kernel command
# line it runs the in-guest test suite and powers off; otherwise it starts an
# interactive shell on the console.
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mkdir -p /etc /mnt
# Drivers this kernel builds as modules (shipped by scripts/guest-assets.sh).
for m in virtio-rng rtc-pl031 netfs 9pnet 9pnet_virtio 9p vsock vmw_vsock_virtio_transport_common vmw_vsock_virtio_transport virtio_input; do
  [ -f /lib/modules/$m.ko ] && insmod /lib/modules/$m.ko 2>/dev/null
done
echo "GUEST: up, kernel $(uname -r), $(nproc) cpus"
if grep -q bendtest /proc/cmdline; then
  sh /tests.sh
  echo "GUEST-TESTS-DONE"
  # poweroff -f halts at once: let the tty send the last line to the UART.
  sleep 0.3
  poweroff -f
fi
# Interactive mode: networking via DHCP from the NAT, and a --share directory
# mounted at /mnt/share.
hostname bend-vmm
ip link set lo up
if [ -e /sys/class/net/eth0 ]; then
  ip link set eth0 up
  udhcpc -i eth0 -q -t 5 -T 1 -n >/dev/null 2>&1 && echo "GUEST: eth0 $(ip -4 addr show eth0 | sed -n 's/.*inet \([0-9.]*\).*/\1/p')"
fi
if grep -qs share /sys/bus/virtio/drivers/9pnet_virtio/*/mount_tag; then
  mkdir -p /mnt/share && mount -t 9p -o trans=virtio,version=9p2000.L share /mnt/share && echo "GUEST: host directory at /mnt/share"
fi
echo "GUEST: busybox shell; 'poweroff -f' to stop, Ctrl-A x to quit the VMM"
# With --display, a second shell on the framebuffer console (tty1), typed
# into through the virtio keyboard.
if [ -e /dev/fb0 ] && [ -e /dev/tty1 ]; then
  echo "GUEST: display shell on tty1"
  setsid sh -c 'while :; do sh -i </dev/tty1 >/dev/tty1 2>&1; done' &
fi
setsid sh -c 'exec sh -i </dev/ttyAMA0 >/dev/ttyAMA0 2>&1'
poweroff -f
